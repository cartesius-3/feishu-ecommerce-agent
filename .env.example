# 复制 .env.example 为 .env 后按需填写；默认全部 mock，无需任何 Key 即可演示

# ===== 运行模式 =====
# mock | deepseek | openai
LLM_MODE=mock
# mock | tei | local
EMBED_MODE=mock
# mock | dianxiaomi | lingxing
MCP_ADAPTER=mock
# mock | mysql
DW_MODE=mock

# ===== LLM（LLM_MODE != mock 时必填）=====
# DeepSeek：https://platform.deepseek.com
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== 数仓（DW_MODE=mysql 时必填）=====
DW_HOST=localhost
DW_PORT=3306
DW_USER=readonly
DW_PASSWORD=
DW_DATABASE=ecommerce_dw

# ===== 飞书（FEISHU_WS_ENABLED=true 时必填）=====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WS_ENABLED=false

# ===== 监控看板（多维表格）=====
BITABLE_APP_TOKEN=
BITABLE_TABLE_ID=
